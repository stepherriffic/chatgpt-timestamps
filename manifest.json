{
  "manifest_version": 3,
  "name": "My Chat Timestamps",
  "version": "1.0.0",
  "description": "Private, local message timestamps for ChatGPT. No analytics, network requests or chat exports.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "My Chat Timestamps",
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }]
}
